{
  "name": "drive-pdf-reader",
  "version": "0.1.0",
  "description": "Google Drive上の書籍・雑誌PDFを、右開き/左開き・見開きで読めるPWAビューア",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
